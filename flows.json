    {
        "id": "g7h8i9j0k1l2",
        "type": "function",
        "z": "d1ea13bb24642f67",
        "g": "71a2b3c4d5e6",
        "name": "PIR & Schedule Lock Logic",
        "func": "// Node-RED 플로우 변수에서 예약 상태를 읽습니다. (캘린더 연동 노드가 설정한다고 가정)\nconst isReserved = flow.get('IsReserved') || false; \nconst pirStatus = msg.payload.d.pir_status;\n\n// 1. 회의 중이고 (IsReserved = true), PIR이 감지된 경우 (Unlock)\nif (isReserved === true && pirStatus === 'on') {\n    // 노쇼 타이머를 리셋하고 문 잠금 해제 명령을 보냅니다.\n    node.status({fill:\"green\",shape:\"dot\",text:\"PIR ON: UNLOCK\"});\n    msg.payload = {\"d\": {\"door\": \"open\"}};\n    return [msg, null]; // 출력 1: 잠금 해제 명령, 출력 2: 노쇼 타이머 중단\n}\n\n// 2. 예약 시간이 아니거나 (IsReserved = false), 기타 상태\nif (isReserved === false) {\n    // PIR 감지 여부와 상관없이 문 잠금 상태 유지\n    node.status({fill:\"blue\",shape:\"dot\",text:\"NOT RESERVED: LOCKED\"});\n    msg.payload = {\"d\": {\"door\": \"close\"}};\n    return [msg, null]; // 출력 1: 잠금 명령, 출력 2: 없음\n}\n\n// 3. 회의 중이고 (IsReserved = true), PIR이 미감지된 경우 (Start/Reset NoShow Timer)\nif (isReserved === true && pirStatus === 'off') {\n    // 노쇼 타이머 시작/리셋 (10분 유예 시간 가정)\n    node.status({fill:\"yellow\",shape:\"dot\",text:\"PIR OFF: START NoShow TIMER\"});\n    // 타이머에 전송할 메시지 (노쇼 발생 시 실행될 메시지)\n    const noshowMsg = {\"payload\": {\"d\": {\"door\": \"close\"}, \"alert\": \"NoShow\"}};\n    return [null, noshowMsg]; // 출력 1: 없음, 출력 2: 타이머 메시지\n}\n\nreturn null;",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
