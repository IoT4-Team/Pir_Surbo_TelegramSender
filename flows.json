        "g": "71a2b3c4d5e6",
        "name": "Lock Door (NoShow Action)",
        "func": "// 노쇼가 최종 확인되면 문을 잠급니다.\nif (msg.payload.d.door === 'close') {\n    return {\"payload\": {\"d\": {\"door\": \"close\"}}};\n}\nreturn null;",
