    {
        "id": "a1b2c3d4e5f6",
        "type": "io7 in",
        "z": "d1ea13bb24642f67",
        "g": "71a2b3c4d5e6",
        "name": "PIR Status In (pir_sensor)",
        "deviceId": "pir_sensor",
        "authentication": "13f60e7c5dfa1d61",
        "evt": "status",
        "fmt": "json",
        "qos": "0",
        "allDevices": false,
        "allEvents": false,
        "allFormats": false,
