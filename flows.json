        "type": "function",
        "z": "d1ea13bb24642f67",
        "g": "71a2b3c4d5e6",
        "name": "NoShow Alert Message",
        "func": "// 노쇼가 최종 확인되면 문을 잠급니다.\nif (msg.payload.alert === 'NoShow') {\n    // 텔레그램으로 보낼 메시지 구성\n    msg.payload = {\n        chatId: \"YOUR_TELEGRAM_CHAT_ID\", // ⚠️ 실제 채팅 ID로 변경 필요\n        type: \"message\",\n        content: \"🚨 [노쇼 감지 및 자동 취소] 예약된 회의실에 10분간 움직임이 없어 예약이 취소되고 문이 잠겼습니다.\"\n    };\n    return msg;\n}\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 710,
        "y": 380,
        "wires": [
